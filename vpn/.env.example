# --- Telegram Bot ---
BOT_TOKEN="YOUR_BOT_TOKEN_HERE"
ADMIN_IDS="123456789,987654321"  # ID администраторов через запятую
SUPPORT_USERNAME="support"
TERMS_URL="https://your-site.com/terms"
SET_URL="https://your-site.com/setup"

# --- Remnawave VPN ---
REMNAWAVE_PANEL_URL="https://your-panel.com"
REMNAWAVE_API_TOKEN="your_api_token_here"
REMNAWAVE_SQUAD_UUID="your_squad_uuid_here"

# --- ЮKassa (Платежи) ---
YOOKASSA_SHOP_ID="your_shop_id"
YOOKASSA_SECRET_KEY="your_secret_key"

# --- Сервер и Порты ---
SERVER_BASE_URL="https://your-domain.com"
WEBHOOK_PORT="8005"

# --- Логи и Данные ---
DATA_DIR="data"
LOG_DIR="logs"

# --- База Данных (PostgreSQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=vpn_bot_db
DATABASE_URL=postgresql://postgres:your_secure_password_here@db:5432/vpn_bot_db
